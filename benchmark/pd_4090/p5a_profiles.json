{
  "profiles": {
    "mooncake-r2": {
      "backend": "mooncake",
      "env": {
        "MC_FORCE_TCP": "1",
        "MC_TCP_ENABLE_CONNECTION_POOL": "1",
        "MC_TCP_LANES_PER_PEER": "8",
        "MC_TCP_MAX_QUEUED_TRANSFERS_PER_PEER": "65535",
        "MC_TCP_MAX_PENDING_ADMISSIONS_PER_PEER": "65535",
        "MC_TCP_ADMISSION_TIMEOUT_MS": "60000",
        "MC_TCP_SLICE_SIZE": "1048576",
        "MC_TRANSFER_TIMEOUT": "300",
        "MC_TCP_STATUS_TIMEOUT_SEC": "120",
        "MC_TCP_PROGRESS_TIMEOUT_SEC": "120",
        "SGLANG_DISAGGREGATION_QUEUE_SIZE": "4",
        "SGLANG_DISAGGREGATION_THREAD_POOL_SIZE": "4",
        "SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT": "3600",
        "SGLANG_DISAGGREGATION_WAITING_TIMEOUT": "3600",
        "GLOG_v": "1"
      }
    },
    "nixl-host": {
      "backend": "nixl",
      "env": {
        "UCX_TLS": "cuda_copy,sm,tcp,self",
        "UCX_NET_DEVICES": "lo",
        "UCX_LOG_LEVEL": "info",
        "SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT": "3600",
        "SGLANG_DISAGGREGATION_WAITING_TIMEOUT": "3600"
      }
    },
    "nixl-ipc-sm": {
      "backend": "nixl",
      "env": {
        "UCX_TLS": "cuda_copy,cuda_ipc,sm,self",
        "UCX_NET_DEVICES": "lo",
        "UCX_LOG_LEVEL": "info",
        "SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT": "3600",
        "SGLANG_DISAGGREGATION_WAITING_TIMEOUT": "3600"
      }
    },
    "nixl-sm": {
      "backend": "nixl",
      "env": {
        "UCX_TLS": "cuda_copy,sm,self",
        "UCX_NET_DEVICES": "lo",
        "UCX_LOG_LEVEL": "info",
        "SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT": "3600",
        "SGLANG_DISAGGREGATION_WAITING_TIMEOUT": "3600"
      }
    },
    "nixl-sm-1m": {
      "backend": "nixl",
      "env": {
        "UCX_TLS": "cuda_copy,sm,self",
        "UCX_NET_DEVICES": "lo",
        "UCX_LOG_LEVEL": "info",
        "SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT": "3600",
        "SGLANG_DISAGGREGATION_WAITING_TIMEOUT": "3600",
        "UCX_POSIX_SEG_SIZE": "1M",
        "UCX_SYSV_SEG_SIZE": "1M",
        "UCX_TCP_TX_SEG_SIZE": "1M",
        "UCX_TCP_RX_SEG_SIZE": "1M"
      }
    }
  }
}
